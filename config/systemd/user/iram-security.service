[Unit]
Description=Iram AI Security Guard Inspection Service
After=network.target

[Service]
Type=oneshot
Environment="PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/bin/sh -c 'if [ -x /usr/local/bin/iram-security-guard ]; then exec /usr/local/bin/iram-security-guard; else exec %h/.local/bin/iram-security-guard; fi'

[Install]
WantedBy=default.target
