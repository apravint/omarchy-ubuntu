{
    "layer": "top",
    "position": "top",
    "height": 34,
    "margin-top": 6,
    "margin-left": 12,
    "margin-right": 12,

    "modules-left": [
        "custom/menu",
        "hyprland/workspaces",
        "hyprland/window"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "custom/theme",
        "cpu",
        "memory",
        "pulseaudio",
        "network",
        "tray",
        "custom/power"
    ],

    "custom/menu": {
        "format": "󰀻",
        "tooltip": false,
        "on-click": "wofi --show drun",
        "on-click-right": "alacritty"
    },

    "hyprland/workspaces": {
        "format": "{name}",
        "on-click": "activate",
        "sort-by-number": true
    },

    "hyprland/window": {
        "max-length": 45,
        "separate-outputs": true,
        "tooltip": false
    },

    "clock": {
        "format": "󰃭 {:%a %b %d  %H:%M}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "on-click-middle": "omarchy menu timezone"
    },

    "custom/theme": {
        "format": "󰔎",
        "tooltip": "Left-click: Theme Switcher | Right-click: Next Wallpaper",
        "on-click": "~/.local/bin/omarchy-theme-switch",
        "on-click-right": "omarchy theme bg next"
    },

    "cpu": {
        "format": "󰍛 {usage}%",
        "interval": 3,
        "on-click": "alacritty -e btop"
    },

    "memory": {
        "format": "󰘚 {percentage}%",
        "interval": 5,
        "on-click": "alacritty -e btop"
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 MUTED",
        "format-icons": {
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-scroll-up": "wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 5%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
    },

    "network": {
        "format-wifi": "󰖩 {essid}",
        "format-ethernet": "󰈀 ETH",
        "format-disconnected": "󰖪 OFFLINE",
        "tooltip-format": "Signal: {signalStrength}% | IP: {ipaddr}",
        "on-click": "nm-connection-editor",
        "on-click-right": "alacritty -e nmtui"
    },

    "tray": {
        "spacing": 10
    },

    "custom/power": {
        "format": "⏻",
        "tooltip": "Power Menu (Lock, Sleep, Logout, Shutdown)",
        "on-click": "~/.local/bin/omarchy-power-menu"
    }
}
