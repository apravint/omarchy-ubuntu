#!/usr/bin/env python3
"""
Iram Stock Market News & Ticker GUI Menu (iram-stock-news)
Fetches live financial headlines, market movers, and index updates.
https://github.com/apravint/iram-os
"""

import sys
import os
import json
import subprocess
import urllib.request
import xml.etree.ElementTree as ET

def fetch_rss_news(query=None, max_items=12):
    if query:
        url = f"https://news.google.com/rss/search?q={urllib.parse.quote(query)}+stock+market&hl=en-US&gl=US&ceid=US:en"
    else:
        url = "https://news.google.com/rss/headlines/section/topic/BUSINESS?hl=en-US&gl=US&ceid=US:en"

    req = urllib.request.Request(url, headers={'User-Agent': 'Mozilla/5.0'})
    try:
        with urllib.request.urlopen(req, timeout=8) as response:
            xml_data = response.read()
            root = ET.fromstring(xml_data)
            items = []
            for item in root.findall('.//item')[:max_items]:
                title = item.find('title').text if item.find('title') is not None else 'No Title'
                link = item.find('link').text if item.find('link') is not None else ''
                pub_date = item.find('pubDate').text if item.find('pubDate') is not None else ''
                items.append({'title': title, 'link': link, 'date': pub_date})
            return items
    except Exception as e:
        return [{'title': f'Error fetching stock news: {e}', 'link': '', 'date': ''}]

def show_wofi_menu():
    symbol = sys.argv[1] if len(sys.argv) > 1 else None
    news = fetch_rss_news(symbol)

    wofi_input = ""
    link_map = {}

    for idx, item in enumerate(news, 1):
        clean_title = item['title'].replace('"', "'")
        entry = f"{idx}. {clean_title}"
        wofi_input += f"{entry}\n"
        link_map[entry] = item['link']

    wofi_cmd = ["wofi", "--dmenu", "--prompt", "📈 Stock Market News...", "--width", "800", "--height", "450"]
    try:
        proc = subprocess.Popen(wofi_cmd, stdin=subprocess.PIPE, stdout=subprocess.PIPE, text=True)
        selected_entry, _ = proc.communicate(input=wofi_input)
        selected_entry = selected_entry.strip()

        if selected_entry and selected_entry in link_map:
            url = link_map[selected_entry]
            if url:
                subprocess.run(["iram-launch-browser", url])
    except Exception as e:
        print(f"Error launching Wofi: {e}")

if __name__ == "__main__":
    show_wofi_menu()
