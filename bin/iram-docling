#!/usr/bin/env python3
"""
Iram Docling Document Converter & Parser (iram-docling)
Converts PDFs, Office documents, presentations, and spreadsheets into structured Markdown.
Optionally indexes converted documents directly into embedded Qdrant vector memory.
https://github.com/apravint/iram-os
"""

import sys
import os
import argparse
import subprocess
from docling.document_converter import DocumentConverter

def convert_document(filepath: str) -> str:
    """
    Convert document to Markdown using Docling.
    """
    abs_path = os.path.abspath(os.path.expanduser(filepath))
    if not os.path.exists(abs_path):
        raise FileNotFoundError(f"File not found: {abs_path}")

    converter = DocumentConverter()
    conv_res = converter.convert(abs_path)
    return conv_res.document.export_to_markdown()

def main():
    parser = argparse.ArgumentParser(description="Iram Docling Document Parser (PDF, Office to Markdown)")
    parser.add_argument("file", help="Path to document (PDF, DOCX, PPTX, XLSX, HTML, etc.)")
    parser.add_argument("-o", "--output", help="Save output Markdown to file")
    parser.add_argument("-i", "--index", action="store_true", help="Index parsed document into Iram Qdrant memory")
    args = parser.parse_args()

    print(f"📄 Parsing document with Docling: {args.file}...")
    try:
        markdown = convert_document(args.file)
    except Exception as e:
        print(f"❌ Docling conversion error: {e}", file=sys.stderr)
        sys.exit(1)

    word_count = len(markdown.split())
    est_tokens = int(word_count * 1.3)
    print(f"✓ Converted successfully! Extracted {word_count} words (~{est_tokens} tokens)")

    if args.output:
        out_path = os.path.abspath(os.path.expanduser(args.output))
        with open(out_path, "w", encoding="utf-8") as f:
            f.write(markdown)
        print(f"✓ Saved Markdown to: {out_path}")
    else:
        print("\n--- BEGIN MARKDOWN PREVIEW ---\n")
        print(markdown[:2000])
        if len(markdown) > 2000:
            print(f"\n... [{len(markdown) - 2000} characters truncated. Use -o <file> to save full output]")
        print("\n--- END MARKDOWN PREVIEW ---")

    if args.index:
        try:
            tmp_md = os.path.expanduser(f"~/.local/state/iram/docling_{os.path.basename(args.file)}.md")
            with open(tmp_md, "w", encoding="utf-8") as f:
                f.write(markdown)
            subprocess.run(["iram-qdrant", "index", tmp_md], check=True)
            print(f"✓ Indexed document into Iram Qdrant collection!")
        except Exception as e:
            print(f"⚠️ Indexing error: {e}")

if __name__ == "__main__":
    main()
