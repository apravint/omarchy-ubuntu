#!/usr/bin/env bash
# Omarchy Interactive Theme Switcher
set -euo pipefail

export OMARCHY_PATH="${OMARCHY_PATH:-/usr/share/omarchy}"

THEMES=$(omarchy theme list)
CURRENT=$(cat "$HOME/.local/state/omarchy/current/theme.name" 2>/dev/null || echo "None")

SELECTED=$(echo "$THEMES" | wofi --dmenu --prompt "Theme (Current: $CURRENT):" --width 380 --height 450)

if [[ -n "${SELECTED:-}" ]]; then
    echo "Switching to Omarchy theme: $SELECTED..."
    omarchy theme set "$SELECTED"

    # Run complete desktop synchronization
    if [[ -x "$HOME/.local/bin/omarchy-theme-sync-all" ]]; then
        "$HOME/.local/bin/omarchy-theme-sync-all" || true
    fi

    notify-send -a "Omarchy" "Theme Changed" "Applied theme: $SELECTED" 2>/dev/null || true
fi
