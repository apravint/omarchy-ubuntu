#!/bin/bash
# Omarchy Cursor Theme Switcher

THEMES=()

# Discover installed cursor themes
for dir in /usr/share/icons/* ~/.icons/* ~/.local/share/icons/*; do
  if [[ -d "$dir/cursors" ]]; then
    THEME_NAME=$(basename "$dir")
    [[ "$THEME_NAME" != "default" && "$THEME_NAME" != "hicolor" ]] && THEMES+=("$THEME_NAME")
  fi
done

# Remove duplicates
mapfile -t UNIQUE_THEMES < <(printf '%s\n' "${THEMES[@]}" | sort -u)

SELECTED="$1"
if [[ -z "$SELECTED" ]]; then
  SELECTED=$(printf '%s\n' "${UNIQUE_THEMES[@]}" | wofi --dmenu --prompt "Select Cursor Theme:" --lines 10 -i)
fi

[[ -z "$SELECTED" ]] && exit 0

# Apply cursor to Hyprland immediately
hyprctl setcursor "$SELECTED" 24 >/dev/null 2>&1 || true

# Apply to GNOME / GTK settings
gsettings set org.gnome.desktop.interface cursor-theme "$SELECTED" >/dev/null 2>&1 || true
gsettings set org.gnome.desktop.interface cursor-size 24 >/dev/null 2>&1 || true

# Persist X11/XWayland default cursor
mkdir -p ~/.icons/default
cat << CURSOR_EOF > ~/.icons/default/index.theme
[Icon Theme]
Name=Default
Comment=Default Cursor Theme
Inherits=$SELECTED
CURSOR_EOF

# Persist for Hyprland config
mkdir -p ~/.config/hypr
cat << CURSOR_EOF > ~/.config/hypr/cursor.conf
# Dynamic Cursor Theme (generated by omarchy-cursor-switch)
env = XCURSOR_THEME,$SELECTED
env = XCURSOR_SIZE,24
env = HYPRCURSOR_THEME,$SELECTED
env = HYPRCURSOR_SIZE,24
CURSOR_EOF

omarchy-notification-send -g 󰇀 "Cursor Theme Updated" "Active cursor set to: $SELECTED"
