#!/usr/bin/env python3
"""
Iram Waybar AI Agent Telemetry Provider (iram-waybar-agent)
Provides real-time agent status, Phoenix traces, Qdrant memory stats, and interactive click actions for Waybar.
https://github.com/apravint/iram-os
"""
import os
import sys
import json
import time
import urllib.request

STATUS_FILE = os.path.expanduser("~/.local/state/iram/agent_status.json")
TRACES_FILE = os.path.expanduser("~/.local/state/iram/agent_traces.jsonl")
GRAPH_FILE = os.path.expanduser("~/.local/state/iram/knowledge_graph.json")

def get_api_key():
    key = os.environ.get("GEMINI_API_KEY") or os.environ.get("GOOGLE_API_KEY")
    if key:
        return key
    env_file = os.path.expanduser("~/.config/environment.d/20-gemini.conf")
    if os.path.exists(env_file):
        try:
            with open(env_file, "r") as f:
                for line in f:
                    line = line.strip()
                    if line.startswith("GEMINI_API_KEY=") or line.startswith("GOOGLE_API_KEY="):
                        val = line.split("=", 1)[1].strip().strip('"').strip("'")
                        if val:
                            return val
        except Exception:
            pass
    return ""

def get_current_model():
    m = os.environ.get("GEMINI_MODEL")
    if m:
        return m
    env_file = os.path.expanduser("~/.config/environment.d/20-gemini.conf")
    if os.path.exists(env_file):
        try:
            with open(env_file, "r") as f:
                for line in f:
                    if line.startswith("GEMINI_MODEL="):
                        return line.split("=", 1)[1].strip().strip('"').strip("'")
        except Exception:
            pass
    return "gemini-3.5-flash-lite"

def get_knowledge_stats():
    entities_count = 0
    edges_count = 0
    if os.path.exists(GRAPH_FILE):
        try:
            with open(GRAPH_FILE, "r") as f:
                kg = json.load(f)
                entities_count = len(kg.get("entities", {}))
                edges_count = len(kg.get("edges", []))
        except Exception:
            pass
    return entities_count, edges_count

def get_last_trace():
    if os.path.exists(TRACES_FILE):
        try:
            with open(TRACES_FILE, "r") as f:
                lines = f.readlines()
                if lines:
                    return json.loads(lines[-1])
        except Exception:
            pass
    return None

def main():
    api_key = get_api_key()
    active_model = get_current_model()
    default_name = f"Gemini ({active_model})" if api_key else "Local (Qwen 2.5)"
    engine_name = "Google Gemini Cloud" if api_key else "Ollama Local Engine"
    
    entities, edges = get_knowledge_stats()
    last_trace = get_last_trace()
    
    # Read active agent status
    agent_state = "idle"
    details = ""
    if os.path.exists(STATUS_FILE):
        try:
            with open(STATUS_FILE, "r") as f:
                st = json.load(f)
                # Expire status after 30 seconds if not refreshed
                if time.time() - st.get("timestamp", 0) < 30:
                    agent_state = st.get("state", "idle")
                    details = st.get("details", "")
        except Exception:
            pass

    # State icon and label
    if agent_state == "thinking":
        icon = "󰑮"
        label = "Thinking..."
        css_class = "thinking"
    elif agent_state == "executing":
        icon = ""
        label = details[:15] if details else "Executing"
        css_class = "executing"
    elif agent_state == "error":
        icon = "󰅚"
        label = "Error"
        css_class = "error"
    else:
        icon = "✨" if api_key else "󱙺"
        label = "Gemini" if api_key else "AI Ready"
        css_class = "idle"

    text = f"{icon} {label}"
    
    last_span_info = "None"
    if last_trace:
        last_span_info = f"{last_trace.get('span')} ({last_trace.get('duration_ms')}ms) [{last_trace.get('status')}]"

    tooltip = (
        f"🤖 Iram Agentic OS HUD\n"
        f"• State: {agent_state.upper()} {f'({details})' if details else ''}\n"
        f"• Model: {default_name}\n"
        f"• Engine: {engine_name}\n"
        f"• Graphiti Memory: {entities} entities, {edges} edges\n"
        f"• Last Trace: {last_span_info}\n\n"
        f"🖱️ Left-Click: Open Agent Interactive Sidecar\n"
        f"🖱️ Right-Click: AI Model Manager\n"
        f"🖱️ Middle-Click: Phoenix Observability UI"
    )

    print(json.dumps({"text": text, "tooltip": tooltip, "class": css_class}))

if __name__ == "__main__":
    main()
