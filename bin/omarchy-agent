#!/usr/bin/env bash
# ==============================================================================
# Omarchy Agentic OS Assistant (Super + A)
# Prompt-driven autonomous actions and window management
# ==============================================================================

set -euo pipefail

PROMPT="${1:-}"

# If no command line prompt passed, open Wofi GUI prompt
if [ -z "$PROMPT" ]; then
    PROMPT=$(wofi --dmenu --prompt "🤖 Ask Omarchy Agentic OS..." --width 600 --height 150 2>/dev/null || true)
fi

if [ -z "$PROMPT" ]; then
    exit 0
fi

# Send desktop notification
if command -v notify-send >/dev/null 2>&1; then
    notify-send -a "Omarchy Agent" "🤖 Processing Request..." "$PROMPT" -t 3000
fi

python3 - "$PROMPT" << 'EOF'
import sys
import json
import urllib.request
import subprocess
import os

prompt = sys.argv[1]
print(f"🤖 Omarchy Agent executing: {prompt}")

sys_prompt = """You are the Omarchy Agentic OS assistant running on Ubuntu Hyprland.
Output concise shell commands or actions to execute the user request.
Common actions:
- hyprctl dispatch workspace <N>
- hyprctl dispatch focuswindow <class>
- omarchy theme set "<theme>"
- pactl set-sink-volume @DEFAULT_AUDIO_SINK@ <level>%
- notify-send "title" "message"
"""

answer = ""
api_key = os.environ.get("GEMINI_API_KEY") or os.environ.get("GOOGLE_API_KEY")

if api_key:
    try:
        gemini_model = os.environ.get("GEMINI_MODEL", "gemini-3.5-flash-lite")
        gemini_url = f"https://generativelanguage.googleapis.com/v1beta/models/{gemini_model}:generateContent?key={api_key}"
        payload = {
            "contents": [{"parts": [{"text": f"{sys_prompt}\nUser: {prompt}\nResponse:"}]}]
        }
        req = urllib.request.Request(
            gemini_url,
            data=json.dumps(payload).encode("utf-8"),
            headers={"Content-Type": "application/json"}
        )
        with urllib.request.urlopen(req, timeout=10) as resp:
            data = json.loads(resp.read().decode("utf-8"))
            answer = data["candidates"][0]["content"]["parts"][0]["text"].strip()
    except Exception:
        pass

if not answer:
    url = "http://localhost:11434/api/generate"
    ollama_model = os.environ.get("OLLAMA_MODEL", "qwen2.5:1.5b")
    data = json.dumps({
        "model": ollama_model,
        "prompt": f"{sys_prompt}\nUser: {prompt}\nResponse:",
        "stream": False
    }).encode("utf-8")

    try:
        req = urllib.request.Request(url, data=data, headers={"Content-Type": "application/json"})
        with urllib.request.urlopen(req, timeout=15) as resp:
            res = json.loads(resp.read().decode("utf-8"))
            answer = res.get("response", "").strip()
    except Exception as e:
        print(f"Error contacting agent model: {e}")
        sys.exit(1)

print("► Agent Response:\n", answer)

# Execute supported system dispatches
for line in answer.split("\n"):
    clean_line = line.strip().strip("`").strip()
    if any(clean_line.startswith(prefix) for prefix in ["hyprctl", "omarchy", "notify-send", "pactl"]):
        print(f"⚡ Dispatching: {clean_line}")
        subprocess.run(clean_line, shell=True)
        
subprocess.run(["notify-send", "-a", "Omarchy Agent", "✓ Action Completed", answer[:120]])
EOF
