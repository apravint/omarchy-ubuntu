#!/bin/bash
# Iram Interactive Reminder Menu via Wofi

CHOICE=$(printf "⏱️ 5m  - Quick Break\n⏱️ 10m - Stretch\n⏱️ 15m - Tea / Coffee\n⏱️ 25m - Pomodoro Focus\n⏱️ 30m - Half Hour\n⏱️ 45m - Standup / Sync\n⏱️ 60m - 1 Hour\n✏️ Custom timer (format: <mins> <message>)\n📋 Show active reminders\n🗑️ Clear all reminders" | wofi --dmenu --prompt "Set Reminder:" --lines 10 -i)

[[ -z "$CHOICE" ]] && exit 0

case "$CHOICE" in
  *"5m"*)
    iram reminder 5 "Quick Break"
    ;;
  *"10m"*)
    iram reminder 10 "Stretch"
    ;;
  *"15m"*)
    iram reminder 15 "Tea / Coffee"
    ;;
  *"25m"*)
    iram reminder 25 "Pomodoro Focus"
    ;;
  *"30m"*)
    iram reminder 30 "Half Hour"
    ;;
  *"45m"*)
    iram reminder 45 "Standup / Sync"
    ;;
  *"60m"*)
    iram reminder 60 "1 Hour"
    ;;
  *"Show active"*)
    iram reminder show
    ;;
  *"Clear all"*)
    iram reminder clear
    ;;
  *)
    # Custom input
    INPUT="$CHOICE"
    if [[ "$INPUT" =~ ^[0-9]+ ]]; then
      MINS=$(echo "$INPUT" | awk '{print $1}')
      MSG=$(echo "$INPUT" | cut -d' ' -f2-)
      [[ "$MINS" == "$MSG" ]] && MSG="Reminder"
      iram reminder "$MINS" "$MSG"
    else
      CUSTOM_IN=$(echo "" | wofi --dmenu --prompt "Enter: <minutes> <message> (e.g. 7 Call client)")
      if [[ -n "$CUSTOM_IN" ]]; then
        MINS=$(echo "$CUSTOM_IN" | awk '{print $1}')
        MSG=$(echo "$CUSTOM_IN" | cut -d' ' -f2-)
        [[ "$MINS" == "$MSG" ]] && MSG="Reminder"
        iram reminder "$MINS" "$MSG"
      fi
    fi
    ;;
esac
