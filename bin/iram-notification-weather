#!/bin/bash
# Iram Weather Notification with graceful fallback

if pgrep -x iram-shell >/dev/null 2>&1; then
  iram-shell shell toggle iram.weather
  exit 0
fi

STATUS=$(iram-weather-status 2>/dev/null || echo "Weather temporarily unavailable")
ICON=$(iram-weather-icon 2>/dev/null || echo "󰖐")
iram-notification-send -g "$ICON" -u low "$STATUS"
