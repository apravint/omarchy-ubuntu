#!/usr/bin/env bash
# Cleanly start / restart Waybar with output readiness check
set -u

# Kill any existing waybar instances
pkill -9 -x waybar 2>/dev/null || true
sleep 0.3

# Wait up to 15 seconds for Hyprland socket & active monitors
for i in {1..30}; do
    if hyprctl monitors 2>/dev/null | grep -q "Monitor "; then
        break
    fi
    sleep 0.5
done

# Give Hyprland layer-shell protocol time to settle after modesetting
sleep 1.5

# Launch waybar in background with log redirection
nohup waybar >/tmp/waybar.log 2>&1 & disown

echo "Waybar launched successfully."
