#!/usr/bin/env bash
# Cleanly start / restart Waybar with output readiness check
set -euo pipefail

# Wait up to 5 seconds for Wayland display & monitors to become available
for i in {1..10}; do
    if hyprctl monitors >/dev/null 2>&1; then
        break
    fi
    sleep 0.5
done

# Kill any stale or unresponsive waybar instance
pkill -x waybar 2>/dev/null || true
sleep 0.2

# Launch waybar in background with log capture
nohup waybar >/tmp/waybar.log 2>&1 &

echo "Waybar started successfully."
