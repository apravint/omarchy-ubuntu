#!/bin/bash
# Omarchy Share Menu via LocalSend

CHOICE=$(printf "📋 Share Clipboard\n📄 Share File\n📁 Share Folder\n📥 Open LocalSend (Receive)" | wofi --dmenu --prompt "Share via LocalSend:" --lines 4 -i)

[[ -z "$CHOICE" ]] && exit 0

case "$CHOICE" in
  *"Clipboard"*)
    omarchy share clipboard
    ;;
  *"File"*)
    omarchy share file
    ;;
  *"Folder"*)
    omarchy share folder
    ;;
  *"Receive"*)
    if command -v localsend >/dev/null 2>&1; then
      localsend &
    else
      omarchy-notification-send -g 󰇮 "LocalSend" "LocalSend application is not installed. Run 'omarchy install app localsend' or download from localsend.org."
    fi
    ;;
esac
