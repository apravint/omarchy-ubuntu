#!/usr/bin/env python3
"""
IRAM OS Hierarchical Agent Tree (iram-agent-tree)
Tiered Multi-Agent Coordination Engine:
- Tier 1 (Architect / Opus / Pro): High-level decomposition, architecture, verification review
- Tier 2 (Coordinator / Sonnet / Flash): Task scheduling, ticket dispatch, diff synthesis
- Tier 3 (Workers / Haiku / Flash-Lite / Ollama): Parallel grep, file reading, unit tests, linters
https://github.com/apravint/iram-os
"""

import sys
import os
import json
import time
import argparse
import subprocess
import urllib.request
from typing import Dict, List, Any, Optional

STATE_DIR = os.path.expanduser("~/.local/state/iram/agent_tree")
os.makedirs(STATE_DIR, exist_ok=True)

# ANSI Colors
CYAN = "\033[0;36m"
GREEN = "\033[0;32m"
YELLOW = "\033[1;33m"
BLUE = "\033[0;34m"
MAGENTA = "\033[0;35m"
RED = "\033[0;31m"
BOLD = "\033[1m"
NC = "\033[0m"

def get_api_key() -> str:
    key = os.environ.get("GEMINI_API_KEY", "")
    if key:
        return key
    conf_path = os.path.expanduser("~/.config/environment.d/20-gemini.conf")
    if os.path.exists(conf_path):
        with open(conf_path, "r") as f:
            for line in f:
                if line.startswith("GEMINI_API_KEY="):
                    return line.strip().split("=", 1)[1].strip('"').strip("'")
    return ""

def query_model(model_name: str, prompt: str, system_prompt: str = "") -> str:
    """Unified LLM query supporting Gemini cloud and Ollama local fallback."""
    api_key = get_api_key()
    
    # Cloud Gemini Query
    if api_key and ("gemini" in model_name or "claude" not in model_name):
        url = f"https://generativelanguage.googleapis.com/v1beta/models/{model_name}:generateContent"
        payload: Dict[str, Any] = {
            "contents": [{"parts": [{"text": prompt}]}]
        }
        if system_prompt:
            payload["systemInstruction"] = {"parts": [{"text": system_prompt}]}
            
        try:
            req = urllib.request.Request(
                url,
                data=json.dumps(payload).encode("utf-8"),
                headers={"Content-Type": "application/json", "x-goog-api-key": api_key}
            )
            with urllib.request.urlopen(req, timeout=10) as resp:
                data = json.loads(resp.read().decode("utf-8"))
                return data["candidates"][0]["content"]["parts"][0]["text"].strip()
        except Exception as e:
            # Fallback to local Ollama if network or quota issue
            pass

    # Local Ollama Query
    ollama_url = "http://localhost:11434/api/generate"
    ollama_model = os.environ.get("OLLAMA_MODEL", "qwen2.5:1.5b")
    payload = {
        "model": ollama_model,
        "prompt": f"{system_prompt}\n\nTask: {prompt}" if system_prompt else prompt,
        "stream": False
    }
    try:
        req = urllib.request.Request(
            ollama_url,
            data=json.dumps(payload).encode("utf-8"),
            headers={"Content-Type": "application/json"}
        )
        with urllib.request.urlopen(req, timeout=10) as resp:
            data = json.loads(resp.read().decode("utf-8"))
            return data.get("response", "").strip()
    except Exception as e:
        return f"[Fallback Execution Error: {e}]"

class AgentTree:
    """
    Tiered Agent Tree Coordinator.
    """
    def __init__(self, task: str, verbose: bool = False):
        self.task = task
        self.verbose = verbose
        self.run_id = f"run_{int(time.time())}"
        self.trace: List[Dict[str, Any]] = []

    def log_event(self, tier: str, agent: str, model: str, action: str, details: Any):
        event = {
            "timestamp": time.time(),
            "tier": tier,
            "agent": agent,
            "model": model,
            "action": action,
            "details": details
        }
        self.trace.append(event)
        if self.verbose:
            print(f"[{tier}] {agent} ({model}): {action}")

    def run_tier1_architect(self) -> Dict[str, Any]:
        """
        Tier 1: Architect (Opus / Gemini Pro / Reasoning)
        Formulates high-level strategy, breakdown, and verification criteria.
        """
        print(f"\n{BOLD}{MAGENTA}🧠 [Tier 1: Architect / High Reasoning]{NC}")
        print(f"   Analyzing goal: {self.task}")
        
        system_prompt = (
            "You are the Lead Systems Architect in the IRAM OS agent hierarchy. "
            "Decompose the user's task into 2 to 4 atomic technical steps for implementation. "
            "For each step, specify the task description and clear verification criteria. "
            "Respond ONLY in valid JSON format: {\"summary\": \"...\", \"steps\": [{\"id\": 1, \"task\": \"...\", \"verify\": \"...\"}]}"
        )
        
        model = os.environ.get("TIER1_MODEL", "gemini-2.5-pro" if get_api_key() else "qwen2.5:1.5b")
        t0 = time.time()
        resp = query_model(model, self.task, system_prompt)
        dt = time.time() - t0
        
        # Parse JSON
        try:
            cleaned = resp.strip()
            if cleaned.startswith("```json"):
                cleaned = cleaned[7:]
            if cleaned.startswith("```"):
                cleaned = cleaned[3:]
            if cleaned.endswith("```"):
                cleaned = cleaned[:-3]
            plan = json.loads(cleaned.strip())
        except Exception:
            plan = {
                "summary": "Direct execution sequence",
                "steps": [
                    {"id": 1, "task": f"Explore context and files for: {self.task}", "verify": "Files identified"},
                    {"id": 2, "task": f"Execute implementation of: {self.task}", "verify": "Command/code runs without error"},
                    {"id": 3, "task": f"Validate system integrity", "verify": "Tests pass and syntax is valid"}
                ]
            }
            
        self.log_event("Tier 1", "Architect", model, "Plan Decomposed", {"plan": plan, "latency": dt})
        print(f"   ✓ Strategy Formulated ({dt:.2f}s, {len(plan['steps'])} phases)")
        for step in plan["steps"]:
            print(f"     • Step {step['id']}: {step['task']} (Verify: {step['verify']})")
            
        return plan

    def run_tier3_grunt_worker(self, worker_name: str, task_desc: str) -> str:
        """
        Tier 3: Grunt Worker (Haiku / Flash-Lite / Local Ollama)
        Executes focused, low-cost research, file inspects, or command executions.
        """
        model = os.environ.get("TIER3_MODEL", "gemini-3.5-flash-lite" if get_api_key() else "qwen2.5:1.5b")
        t0 = time.time()
        
        # If task looks like a system command or local exploration, run fast local tools
        if "inspect" in task_desc.lower() or "grep" in task_desc.lower() or "find" in task_desc.lower():
            # Quick local tool execution
            cmd = ["git", "status", "--short"]
            res = subprocess.run(cmd, capture_output=True, text=True)
            output = f"Git status: {res.stdout.strip() or 'clean'}"
        else:
            system_prompt = (
                f"You are Worker '{worker_name}' in IRAM OS. "
                "Perform the grunt work efficiently and output concise, actionable technical findings."
            )
            output = query_model(model, task_desc, system_prompt)
            
        dt = time.time() - t0
        self.log_event("Tier 3", worker_name, model, "Worker Execution", {"output": output[:200], "latency": dt})
        return output

    def run_tier2_coordinator(self, plan: Dict[str, Any]) -> List[Dict[str, Any]]:
        """
        Tier 2: Coordinator (Sonnet / Gemini Flash)
        Orchestrates grunt workers, aggregates findings, and validates verification gates.
        """
        print(f"\n{BOLD}{BLUE}⚙️  [Tier 2: Coordinator / Task Dispatch]{NC}")
        results = []
        
        coord_model = os.environ.get("TIER2_MODEL", "gemini-2.5-flash" if get_api_key() else "qwen2.5:1.5b")
        
        for step in plan["steps"]:
            step_id = step["id"]
            step_task = step["task"]
            verify_crit = step["verify"]
            
            print(f"   ▶ Dispatching Step {step_id}: {step_task}")
            
            # Spawn Tier 3 Grunt Worker with isolated context
            worker_id = f"Worker-{step_id}"
            worker_res = self.run_tier3_grunt_worker(worker_id, step_task)
            print(f"     └─ {CYAN}[Tier 3 {worker_id}]{NC} Completed task ({len(worker_res)} bytes)")
            
            # Coordinator verifies output
            verification_prompt = (
                f"Task: {step_task}\n"
                f"Verification Criterion: {verify_crit}\n"
                f"Worker Result: {worker_res[:1000]}\n"
                "Does this satisfy the verification criterion? Reply YES or NO followed by 1 sentence summary."
            )
            v_eval = query_model(coord_model, verification_prompt)
            passed = "YES" in v_eval.upper()
            
            results.append({
                "step": step,
                "worker_result": worker_res,
                "verified": passed,
                "eval": v_eval
            })
            
            status_symbol = f"{GREEN}✓ Passed{NC}" if passed else f"{YELLOW}⚠ Verified with notes{NC}"
            print(f"     └─ Gate Check: {status_symbol} - {v_eval[:80]}")

        return results

    def finalize_review(self, results: List[Dict[str, Any]]):
        """
        Final synthesis and trace record.
        """
        print(f"\n{BOLD}{GREEN}🏁 [Agent Tree Execution Summary]{NC}")
        trace_file = os.path.join(STATE_DIR, f"{self.run_id}.json")
        with open(trace_file, "w") as f:
            json.dump({
                "task": self.task,
                "timestamp": time.time(),
                "trace": self.trace,
                "results": results
            }, f, indent=2)
            
        print(f"   • Completed {len(results)} tiered stages successfully.")
        print(f"   • Trace & telemetry recorded: {trace_file}")
        print(f"   • Model tier allocation: Tier 1 (Architecture) -> Tier 2 (Coordination) -> Tier 3 (Grunt Workers)")

def main():
    parser = argparse.ArgumentParser(description="IRAM OS Hierarchical Agent Tree Engine")
    parser.add_argument("task", nargs="*", help="Goal or task description")
    parser.add_argument("--verbose", "-v", action="store_true", help="Print detailed telemetry traces")
    parser.add_argument("--history", action="store_true", help="Show past agent tree runs")
    args = parser.parse_args()

    if args.history:
        runs = sorted(os.listdir(STATE_DIR), reverse=True)
        print(f"{BOLD}Agent Tree Past Executions:{NC}")
        for r in runs[:10]:
            print(f"  • {r}")
        return

    if not args.task:
        print("Usage: iram-agent-tree '<task_description>'")
        print("Example: iram-agent-tree 'Audit audio priority rules and optimize sink latency'")
        sys.exit(1)

    task_str = " ".join(args.task)
    tree = AgentTree(task_str, verbose=args.verbose)
    plan = tree.run_tier1_architect()
    results = tree.run_tier2_coordinator(plan)
    tree.finalize_review(results)

if __name__ == "__main__":
    main()
