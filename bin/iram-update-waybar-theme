#!/usr/bin/env python3
import os
import re

toml_path = os.path.expanduser("~/.local/state/omarchy/current/theme/colors.toml")
css_path = os.path.expanduser("~/.config/waybar/colors.css")

colors = {
    "background": "#1a1b26",
    "dark_background": "#16161e",
    "foreground": "#c0caf5",
    "accent": "#7aa2f7",
    "muted": "#565f89",
}

if os.path.exists(toml_path):
    with open(toml_path, "r", encoding="utf-8") as f:
        for line in f:
            m = re.match(r'^([a-zA-Z_]+)\s*=\s*["\']([^"\']+)["\']', line.strip())
            if m:
                key, val = m.group(1), m.group(2)
                colors[key] = val

bg = colors.get("dark_background", colors.get("background", "#1a1b26"))
fg = colors.get("foreground", "#c0caf5")
accent = colors.get("accent", colors.get("blue", "#7aa2f7"))
muted = colors.get("muted", "#565f89")

# Convert hex to rgb
def hex_to_rgb(hex_str, default=(26, 27, 38)):
    h = hex_str.lstrip("#")
    if len(h) == 6:
        return int(h[0:2], 16), int(h[2:4], 16), int(h[4:6], 16)
    return default

r_bg, g_bg, b_bg = hex_to_rgb(bg, (26, 27, 38))
r_acc, g_acc, b_acc = hex_to_rgb(accent, (122, 162, 247))
r_sel, g_sel, b_sel = hex_to_rgb(colors.get("selection", "#292e42"), (41, 46, 66))

css_content = f"""/* Auto-generated by Omarchy Theme Engine */
@define-color bg rgba({r_bg}, {g_bg}, {b_bg}, 0.85);
@define-color fg {fg};
@define-color accent {accent};
@define-color accent_rgba rgba({r_acc}, {g_acc}, {b_acc}, 0.25);
@define-color accent_glow rgba({r_acc}, {g_acc}, {b_acc}, 0.45);
@define-color muted {muted};
@define-color border rgba({r_acc}, {g_acc}, {b_acc}, 0.35);
@define-color selection rgba({r_sel}, {g_sel}, {b_sel}, 0.8);
"""

os.makedirs(os.path.dirname(css_path), exist_ok=True)
with open(css_path, "w", encoding="utf-8") as f:
    f.write(css_content)

print(f"Waybar colors updated: accent={accent}, bg={bg}")
