#!/usr/bin/env python3
"""
Iram Audio Output Cycler (iram-audio-toggle)
Dynamically cycles through all available audio outputs:
- Bluetooth (e.g. JBL Flip 4, headphones)
- Samsung Monitor (HDMI)
- Sony TV (HDMI)
- All Displays (Combined)
Moves all active audio streams and notifies the user.
https://github.com/apravint/iram-ubuntu
"""

import subprocess
import json
import sys

def get_sinks():
    try:
        out = subprocess.check_output(["pactl", "-f", "json", "list", "sinks"], text=True)
        sinks = json.loads(out)
        # Filter out internal dummy sinks
        valid_sinks = [s for s in sinks if "dummy" not in s.get("name", "").lower()]
        return valid_sinks
    except Exception as e:
        print(f"Error listing sinks: {e}")
        return []

def get_default_sink():
    try:
        return subprocess.check_output(["pactl", "get-default-sink"], text=True).strip()
    except Exception:
        return ""

def main():
    sinks = get_sinks()
    if not sinks:
        sys.exit(0)

    current_default = get_default_sink()
    sink_names = [s["name"] for s in sinks]

    # Find next sink in cycle
    try:
        curr_idx = sink_names.index(current_default)
        next_idx = (curr_idx + 1) % len(sink_names)
    except ValueError:
        next_idx = 0

    target_sink = sinks[next_idx]
    target_name = target_sink["name"]
    display_name = target_sink.get("description") or target_name

    # Set default sink
    subprocess.run(["pactl", "set-default-sink", target_name], check=False)
    subprocess.run(["pactl", "set-sink-mute", target_name, "0"], check=False)

    # Move active playback streams to new sink
    try:
        inputs_out = subprocess.check_output(["pactl", "list", "sink-inputs", "short"], text=True)
        for line in inputs_out.strip().split("\n"):
            if line.strip():
                input_id = line.split()[0]
                subprocess.run(["pactl", "move-sink-input", input_id, target_name], check=False)
    except Exception:
        pass

    # Send desktop alert with appropriate icon
    icon = "audio-speakers-bluetooth" if "bluez" in target_name else "audio-card"
    subprocess.run([
        "notify-send",
        "-a", "Iram Audio",
        "🔊 Audio Output Switched",
        f"Active Device: {display_name}",
        "-i", icon,
        "-t", "2500"
    ], check=False)

    print(f"✓ Switched to {display_name} ({target_name})")

if __name__ == "__main__":
    main()
