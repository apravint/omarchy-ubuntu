#!/usr/bin/env python3
"""
Omarchy Episodic Vector Memory Layer (omarchy-memory)
Indexes user document notes, terminal history, and project code for semantic AI memory search.
Powered by Local Embedded Qdrant Vectors + Graphiti Knowledge Graph.
https://github.com/apravint/omarchy-ubuntu
"""

import sys
import os
import json
import subprocess
from typing import List, Tuple

def add_memory(category: str, content: str):
    """
    Save memory into both Qdrant vector memory and Graphiti knowledge graph.
    """
    try:
        # 1. Qdrant
        subprocess.run(["omarchy-qdrant", "add-memory", content, "--category", category], check=True)
        # 2. Graphiti
        subprocess.run(["omarchy-graphiti", "fact", content, "--tags", category], check=True)
    except Exception as e:
        print(f"Error persisting memory: {e}")

def search_memory(query: str, top_k: int = 5):
    """
    Query Qdrant memory collection.
    """
    try:
        res = subprocess.run(["omarchy-qdrant", "search-memory", query, "--limit", str(top_k)], capture_output=True, text=True)
        return res.stdout.strip()
    except Exception as e:
        return f"Search error: {e}"

def main():
    if len(sys.argv) > 2 and sys.argv[1] == "add":
        cat = "general"
        content = " ".join(sys.argv[2:])
        add_memory(cat, content)
    elif len(sys.argv) > 1 and sys.argv[1] in ["--help", "-h"]:
        print("Usage:")
        print("  omarchy-memory add '<content>'        Add memory fact")
        print("  omarchy-memory '<search_query>'       Semantic memory search")
        print("  omarchy-memory status                 Show memory & vector statistics")
    elif len(sys.argv) > 1 and sys.argv[1] == "status":
        subprocess.run(["omarchy-qdrant", "status"])
        subprocess.run(["omarchy-graphiti", "search", ""])
    elif len(sys.argv) > 1:
        query = " ".join(sys.argv[1:])
        print(search_memory(query))
    else:
        print("Usage: omarchy-memory <search_query> OR omarchy-memory add 'content'")

if __name__ == "__main__":
    main()
