#!/usr/bin/env bash
# ==============================================================================
# Iram Agentic OS Sidecar Window (Super + Shift + A)
# Launches a floating interactive agent terminal sidecar
# ==============================================================================
set -euo pipefail

INTERACTIVE_BIN="$HOME/.local/bin/iram-agent-interactive"
if [ ! -f "$INTERACTIVE_BIN" ]; then
    INTERACTIVE_BIN="$(dirname "$0")/iram-agent-interactive"
fi

if command -v alacritty >/dev/null 2>&1; then
    alacritty --title "Iram Agent Sidecar" \
              --class "IramSidecar" \
              --option "window.dimensions.columns=95" \
              --option "window.dimensions.lines=32" \
              -e "$INTERACTIVE_BIN"
else
    "$INTERACTIVE_BIN"
fi
