#!/usr/bin/env bash
# ==============================================================================
# Omarchy Agentic OS Sidecar Window (Super + Shift + A)
# Launches a floating interactive agent terminal sidecar
# ==============================================================================
set -euo pipefail

INTERACTIVE_BIN="$HOME/.local/bin/omarchy-agent-interactive"
if [ ! -f "$INTERACTIVE_BIN" ]; then
    INTERACTIVE_BIN="$(dirname "$0")/omarchy-agent-interactive"
fi

if command -v alacritty >/dev/null 2>&1; then
    alacritty --title "Omarchy Agent Sidecar" \
              --class "OmarchySidecar" \
              --option "window.dimensions.columns=95" \
              --option "window.dimensions.lines=32" \
              -e "$INTERACTIVE_BIN"
else
    "$INTERACTIVE_BIN"
fi
