#!/usr/bin/env bash
# Cleanly start / restart Waybar via systemd user service with output readiness check
set -u

# Ensure Wayland environment is imported into systemd user session
dbus-update-activation-environment --systemd WAYLAND_DISPLAY HYPRLAND_INSTANCE_SIGNATURE XDG_CURRENT_DESKTOP 2>/dev/null || true

# Wait up to 15 seconds for Hyprland socket & active monitors
for i in {1..30}; do
    if hyprctl monitors 2>/dev/null | grep -q "Monitor "; then
        break
    fi
    sleep 0.5
done

# Restart Waybar service cleanly
systemctl --user restart waybar

echo "Waybar service restarted successfully."
