#!/usr/bin/env python3
"""
Iram Code-as-Action Agent (iram-code-agent)
Executes autonomous desktop actions and complex workflows by writing and executing Python code.
Powered by HuggingFace smolagents architecture.
https://github.com/apravint/iram-ubuntu
"""

import sys
import os
import json
import subprocess
import argparse
from smolagents import tool, CodeAgent, LocalPythonExecutor

# Define smolagents tools for OS control
@tool
def get_desktop_windows() -> str:
    """
    Get all active desktop windows, workspaces, geometry, and window classes in Hyprland.
    Returns:
        JSON string of active windows.
    """
    try:
        out = subprocess.check_output(["hyprctl", "clients", "-j"], text=True)
        clients = json.loads(out)
        summary = [{"address": c.get("address"), "class": c.get("class"), "title": c.get("title"), "workspace": c.get("workspace", {}).get("name")} for c in clients if c.get("mapped")]
        return json.dumps(summary)
    except Exception as e:
        return f"Error: {e}"

@tool
def focus_window_by_name(target: str) -> str:
    """
    Focus a window by class name or title substring (e.g. 'Alacritty', 'Chrome', 'Spotify').
    Args:
        target: Substring of the window class or title to focus.
    Returns:
        Confirmation message.
    """
    try:
        out = subprocess.check_output(["hyprctl", "clients", "-j"], text=True)
        clients = json.loads(out)
        for c in clients:
            if target.lower() in c.get("class", "").lower() or target.lower() in c.get("title", "").lower():
                addr = c.get("address")
                subprocess.run(["hyprctl", "dispatch", "focuswindow", f"address:{addr}"], check=True)
                return f"Successfully focused window {c.get('class')} ({addr})"
        return f"Window '{target}' not found."
    except Exception as e:
        return f"Error: {e}"

@tool
def execute_hyprctl(dispatcher: str, args: str = "") -> str:
    """
    Execute a Hyprland dispatcher command (e.g. workspace 2, togglefloating, killactive).
    Args:
        dispatcher: The dispatcher name.
        args: Arguments for dispatcher.
    Returns:
        Output string.
    """
    try:
        cmd = ["hyprctl", "dispatch", dispatcher]
        if args:
            cmd.append(args)
        res = subprocess.run(cmd, capture_output=True, text=True)
        return res.stdout.strip() or f"Dispatched {dispatcher}"
    except Exception as e:
        return f"Error: {e}"

@tool
def search_code_qdrant(query: str, limit: int = 3) -> str:
    """
    Perform semantic vector search across local codebase and configs using embedded Qdrant.
    Args:
        query: The semantic search query.
        limit: Number of matches to return.
    Returns:
        Matching code snippets.
    """
    try:
        res = subprocess.run(["iram-qdrant", "search", query, "-n", str(limit)], capture_output=True, text=True)
        return res.stdout.strip()
    except Exception as e:
        return f"Error: {e}"

@tool
def scrape_web_docs(url: str) -> str:
    """
    Scrape live web documentation into token-efficient markdown using Crawl4AI.
    Args:
        url: The web URL to scrape.
    Returns:
        Clean markdown text.
    """
    try:
        res = subprocess.run(["iram-crawl", url], capture_output=True, text=True)
        return res.stdout.strip()[:2000]
    except Exception as e:
        return f"Error: {e}"

@tool
def record_knowledge_fact(fact: str) -> str:
    """
    Save a persistent project fact into the Iram Knowledge Graph.
    Args:
        fact: Fact text to record.
    Returns:
        Confirmation message.
    """
    try:
        res = subprocess.run(["iram-graphiti", "fact", fact], capture_output=True, text=True)
        return res.stdout.strip()
    except Exception as e:
        return f"Error: {e}"

from smolagents.local_python_executor import evaluate_python_code

def execute_code_block(code_str: str) -> str:
    """
    Direct local python execution of code actions using smolagents AST sandbox.
    """
    tools_dict = {
        "get_desktop_windows": get_desktop_windows,
        "focus_window_by_name": focus_window_by_name,
        "execute_hyprctl": execute_hyprctl,
        "search_code_qdrant": search_code_qdrant,
        "scrape_web_docs": scrape_web_docs,
        "record_knowledge_fact": record_knowledge_fact
    }
    authorized = ["subprocess", "json", "os", "sys", "math", "re", "collections", "time", "datetime"]
    try:
        out, is_final = evaluate_python_code(
            code_str,
            static_tools=tools_dict,
            authorized_imports=authorized
        )
        return f"=== Output ===\n{out}"
    except Exception as e:
        return f"Execution error: {e}"

def main():
    parser = argparse.ArgumentParser(description="Iram Code-as-Action Agent (smolagents)")
    parser.add_argument("prompt_or_code", help="Action prompt or Python code to execute")
    parser.add_argument("-c", "--code", action="store_true", help="Execute input directly as Python code action")
    args = parser.parse_args()

    if args.code:
        print(f"🤖 Executing Code Action...")
        out = execute_code_block(args.prompt_or_code)
        print(out)
    else:
        # Check if input is a code snippet
        if "def " in args.prompt_or_code or "import " in args.prompt_or_code or "=" in args.prompt_or_code and ";" in args.prompt_or_code:
            out = execute_code_block(args.prompt_or_code)
            print(out)
        else:
            print(f"🤖 Synthesizing Code Action for: '{args.prompt_or_code}'...")
            # Generate code action via local template / LLM
            prompt = args.prompt_or_code.lower()
            code_action = ""
            if "window" in prompt or "focus" in prompt or "switch" in prompt:
                target = prompt.replace("focus", "").replace("switch to", "").replace("window", "").strip()
                code_action = f"res = focus_window_by_name('{target}')\nfinal_answer = res"
            elif "workspace" in prompt:
                import re
                m = re.search(r"\d+", prompt)
                ws = m.group(0) if m else "1"
                code_action = f"res = execute_hyprctl('workspace', '{ws}')\nfinal_answer = res"
            elif "search" in prompt or "find" in prompt:
                query = prompt.replace("search", "").replace("find", "").strip()
                code_action = f"res = search_code_qdrant('{query}')\nfinal_answer = res"
            else:
                code_action = f"windows = get_desktop_windows()\nfinal_answer = f'Active windows count: {{len(json.loads(windows))}}'"

            print(f"Executing generated code action:\n```python\n{code_action}\n```\n")
            out = execute_code_block(code_action)
            print(out)

if __name__ == "__main__":
    main()
