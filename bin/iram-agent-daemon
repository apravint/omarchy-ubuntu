#!/usr/bin/env python3
"""
Iram Agentic OS Daemon (iram-agent-daemon)
Background service managing agent state, Waybar status reporting, and REST trigger API.
"""

import sys
import os
import json
import time
import subprocess
from http.server import HTTPServer, BaseHTTPRequestHandler
import threading

def get_api_key():
    key = os.environ.get("GEMINI_API_KEY") or os.environ.get("GOOGLE_API_KEY")
    if key:
        return key
    env_file = os.path.expanduser("~/.config/environment.d/20-gemini.conf")
    if os.path.exists(env_file):
        try:
            with open(env_file, "r") as f:
                for line in f:
                    line = line.strip()
                    if line.startswith("GEMINI_API_KEY=") or line.startswith("GOOGLE_API_KEY="):
                        val = line.split("=", 1)[1].strip().strip('"').strip("'")
                        if val:
                            return val
        except Exception:
            pass
    return ""

def get_current_model():
    m = os.environ.get("GEMINI_MODEL")
    if m:
        return m
    env_file = os.path.expanduser("~/.config/environment.d/20-gemini.conf")
    if os.path.exists(env_file):
        try:
            with open(env_file, "r") as f:
                for line in f:
                    if line.startswith("GEMINI_MODEL="):
                        return line.split("=", 1)[1].strip().strip('"').strip("'")
        except Exception:
            pass
    return "gemini-3.5-flash-lite"

api_key = get_api_key()
active_model = get_current_model()
default_model = f"Gemini ({active_model})" if api_key else "qwen2.5:1.5b"
engine = "Google Gemini Cloud (0% CPU)" if api_key else "Ollama Local (qwen2.5)"

AGENT_STATE = {
    "status": "Idle",
    "last_task": "None",
    "model": default_model,
    "engine": engine,
    "updated_at": time.time()
}

class AgentRequestHandler(BaseHTTPRequestHandler):
    def do_GET(self):
        if self.path == "/api/status":
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.end_headers()
            self.wfile.write(json.dumps(AGENT_STATE).encode("utf-8"))
        else:
            self.send_response(404)
            self.end_headers()

    def do_POST(self):
        if self.path == "/api/execute":
            content_length = int(self.headers.get("Content-Length", 0))
            body = self.rfile.read(content_length)
            try:
                data = json.loads(body.decode("utf-8"))
                prompt = data.get("prompt", "")
                
                AGENT_STATE["status"] = "Executing..."
                AGENT_STATE["last_task"] = prompt
                AGENT_STATE["updated_at"] = time.time()

                # Trigger iram-agent in background
                subprocess.Popen(["iram-agent", prompt])

                self.send_response(200)
                self.send_header("Content-Type", "application/json")
                self.end_headers()
                self.wfile.write(json.dumps({"status": "accepted", "prompt": prompt}).encode("utf-8"))
            except Exception as e:
                self.send_response(500)
                self.end_headers()
                self.wfile.write(str(e).encode("utf-8"))
        else:
            self.send_response(404)
            self.end_headers()

    def log_message(self, format, *args):
        pass

def run_server(port=9090):
    server_address = ("127.0.0.1", port)
    httpd = HTTPServer(server_address, AgentRequestHandler)
    print(f"🤖 Iram Agentic OS Daemon listening on http://127.0.0.1:{port}")
    httpd.serve_forever()

if __name__ == "__main__":
    run_server()
