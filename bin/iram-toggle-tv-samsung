#!/usr/bin/env bash
# Iram Display Audio Switcher (Cycle: Both Displays -> Samsung Only -> Sony TV Only)

CURRENT_SINK=$(pactl get-default-sink 2>/dev/null)

case "$CURRENT_SINK" in
    *"combined_displays"*)
        TARGET_SINK="alsa_output.pci-0000_01_00.1.playback.7.0"
        LABEL="Samsung Monitor Only"
        ICON="video-display"
        NVIDIA_HW=$(ls -d /sys/bus/pci/devices/0000:01:00.1/sound/card*/hwC*D0 2>/dev/null | head -n 1)
        if [[ -n "$NVIDIA_HW" ]] && command -v hda-verb >/dev/null 2>&1; then
            DEV_PATH="/dev/snd/$(basename "$NVIDIA_HW")"
            if [[ -e "$DEV_PATH" ]]; then
                hda-verb "$DEV_PATH" 0x05 SET_PIN_WIDGET_CONTROL 0x40 >/dev/null 2>&1 || true
                hda-verb "$DEV_PATH" 0x05 SET_CONNECT_SEL 0x01 >/dev/null 2>&1 || true
            fi
        fi
        ;;
    *"playback.7.0"*|*"pro-output-7"*|*"extra1"*)
        TARGET_SINK="alsa_output.pci-0000_01_00.1.playback.3.0"
        LABEL="Sony TV Only"
        ICON="tv"
        ;;
    *)
        TARGET_SINK="combined_displays"
        LABEL="Both Displays (Samsung & Sony TV)"
        ICON="audio-speakers"
        ;;
esac

pactl set-default-sink "$TARGET_SINK" 2>/dev/null || true
pactl set-sink-mute "$TARGET_SINK" 0 2>/dev/null || true
pactl set-sink-volume "$TARGET_SINK" 100% 2>/dev/null || true

# Redirect active streams
for input in $(pactl list sink-inputs short 2>/dev/null | awk '{print $1}'); do
    pactl move-sink-input "$input" "$TARGET_SINK" 2>/dev/null || true
done

notify-send -i "$ICON" -t 2500 "Audio Output" "Switched to: $LABEL" 2>/dev/null || true
echo "Switched audio output to $LABEL ($TARGET_SINK)"
